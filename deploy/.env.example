# 复制为 deploy/.env 后修改所有密码；不要提交 deploy/.env。
DB_NAME=lab_agent
DB_USERNAME=lab_agent
DB_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_root_password
REDIS_PASSWORD=change_this_redis_password
# 使用至少 32 字节随机密钥的 Base64 编码；不要提交真实值。
JWT_SECRET=replace_with_a_base64_encoded_32_byte_secret
# 多个来源以英文逗号分隔；生产环境填写实际前端地址。
CORS_ALLOWED_ORIGINS=http://localhost:5173
# 启用知识库向量检索与 OpenAI 模型后必须提供真实密钥；请勿提交真实值。
KNOWLEDGE_RAG_ENABLED=true
KNOWLEDGE_STORAGE_PATH=knowledge/uploads
SPRING_AI_MODEL_CHAT=openai
SPRING_AI_MODEL_EMBEDDING=openai
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
