# 复制为 deploy/.env 后修改所有密码；不要提交 deploy/.env。
DB_NAME=lab_agent
DB_USERNAME=lab_agent
DB_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_root_password
REDIS_PASSWORD=change_this_redis_password
# 使用至少 32 字节随机密钥的 Base64 编码；不要提交真实值。
JWT_SECRET=replace_with_a_base64_encoded_32_byte_secret
# 多个来源以英文逗号分隔；生产环境填写实际前端地址。
CORS_ALLOWED_ORIGINS=http://localhost:5173
# StepFun 作为 OpenAI 兼容聊天与工具调用端点；请勿提交真实密钥。
KNOWLEDGE_RAG_ENABLED=true
KNOWLEDGE_STORAGE_PATH=knowledge/uploads
SPRING_AI_VECTORSTORE_TYPE=redis
SPRING_AI_MODEL_CHAT=openai
OPENAI_BASE_URL=https://api.stepfun.com/v1
OPENAI_API_KEY=replace_with_stepfun_api_key
OPENAI_CHAT_MODEL=step-3.7-flash
# DashScope（百炼北京地域）只负责知识库 Embedding。将 Workspace ID 替换为实际业务空间 ID。
SPRING_AI_MODEL_EMBEDDING=openai
DASHSCOPE_API_KEY=replace_with_dashscope_api_key
DASHSCOPE_WORKSPACE_ID=replace_with_dashscope_workspace_id
DASHSCOPE_EMBEDDING_BASE_URL=https://replace_with_dashscope_workspace_id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
