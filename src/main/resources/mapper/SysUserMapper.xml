<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.decadedx.springaiagent.mapper.SysUserMapper">
    <select id="selectByIdForUpdate" resultType="io.github.decadedx.springaiagent.entity.SysUser">
        SELECT id, username, password_hash, role, training_status, created_at, updated_at
        FROM sys_user
        WHERE id = #{userId}
        FOR UPDATE
    </select>
</mapper>
